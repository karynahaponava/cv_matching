server {
    listen 443 ssl;
    server_name ${DOMAIN_DEV};
    ssl_certificate /etc/letsencrypt/live/${DOMAIN_DEV}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_DEV}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    auth_basic "Restricted";
    auth_basic_user_file /etc/nginx/user_conf.d/.htpasswd;
    location / {
        proxy_pass http://cv_matching_frontend_dev:8501;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
    location /api/ {
        proxy_pass http://cv_matching_backend_dev:8000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /pgadmin/ {
        auth_basic "Restricted";
        auth_basic_user_file /etc/nginx/user_conf.d/.htpasswd;
        proxy_pass http://cv_matching_pgadmin_dev:80;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name /pgadmin;
        proxy_redirect off;
    }
}
